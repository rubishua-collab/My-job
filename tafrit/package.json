{
  "name": "tafrit-yomi-robi",
  "version": "1.0.0",
  "private": true,
  "description": "תפריט יומי רובי — אפליקציית תזונה אישית (PWA) בעברית, עם מאגר התזונה הלאומי, חישובי יעדים, יומן ושקילות",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "test": "node --no-warnings --test test/unit/*.test.js",
    "e2e": "node --no-warnings test/e2e-multiuser.mjs",
    "build-foods": "python3 -I scripts/build-foods.py",
    "import-world-foods": "python3 -I scripts/import-world-foods.py",
    "e2e:planner": "node --no-warnings test/e2e-planner.mjs",
    "week-sim": "node --no-warnings test/week-sim.mjs",
    "e2e:app": "node --no-warnings test/e2e-appbundle.mjs",
    "e2e:legacy": "node --no-warnings test/e2e-legacy-features.mjs",
    "e2e:likes": "node --no-warnings test/e2e-likes.mjs",
    "e2e:single": "node test/e2e-iphone.cjs",
    "app:build": "node scripts/build-app.mjs && npx cap sync",
    "store:screenshots": "node --no-warnings scripts/store-screenshots.mjs",
    "icons": "node scripts/make-icons.cjs && node scripts/make-splash.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  }
}